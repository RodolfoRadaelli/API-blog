# Compiled class files
*.class

# Package Files
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Maven build output
/target/
/build/
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper (mantener scripts, ignorar JAR descargado)
.mvn/wrapper/maven-wrapper.jar

# Gradle (si lo usas)
.gradle/
/build/
!gradle/wrapper/gradle-wrapper.jar

# Log files
*.log
logs/

