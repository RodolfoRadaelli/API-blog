# Compiled class files
*.class

# Package Files
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Maven/Gradle build output directories
/target/
/build/

# Maven wrapper files (executable scripts are usually kept, but the downloaded JAR can be ignored)
.mvn/wrapper/maven-wrapper.jar

# Log files
*.log
logs/

# IDE specific files and directories

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
# NetBeans userdir/cache files (sometimes generated outside project root, but good to have)
# /~/.netbeans/

# IntelliJ IDEA (common for many Java devs)
.idea/
*.iws
*.iml
*.ipr

# Eclipse (common for many Java devs)
.classpath
.project
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache # STS specific

# VS Code
.vscode/

# Operating System Files
.DS_Store # macOS
Thumbs.db # Windows
.localized
ehthumbs.db
Desktop.ini

# Environment variables files (often contain sensitive info)
.env
.env.*

# Generated test reports/output
/test-output/
/surefire-reports/
/failsafe-reports/

# Other temporary files
*~
*.bak
*.swp
